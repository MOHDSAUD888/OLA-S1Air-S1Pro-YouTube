<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FLEET"
        android:textColor="@color/dim"
        android:textSize="10sp"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/total_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0"
            android:textColor="@color/text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/total_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="scooters"
            android:textColor="@color/dim"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/widget_card_bg"
        android:padding="10dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/online_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@drawable/widget_status_dot" />

        <TextView
            android:id="@+id/online_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 online"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/offline_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(0 offline)"
            android:textColor="@color/dim"
            android:textSize="11sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No scooters added"
        android:textColor="@color/dim"
        android:textSize="11sp"
        android:layout_marginTop="8dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|center"
        android:text="Tap to open Pegasus"
        android:textColor="@color/dim"
        android:textSize="9sp"
        android:alpha="0.6" />
</LinearLayout>
